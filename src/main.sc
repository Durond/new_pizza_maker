require: slotfilling/slotFilling.sc
    module = sys.zb-common

theme: /

    state: Start
        q!: * (start|начать|привет) *
        a: Здравствуйте! Я помогу заказать пиццу.
        go!: /Выбор пиццы

    state: Выбор пиццы
        a: Выберите пиццу
        buttons:
            "Мясная пицца" -> /Выберите размер пиццы
            "Сырная" -> /Выберите размер пиццы
            "Грибная" -> /Выберите размер пиццы

    state: Выберите размер пиццы
        a: Выберите размер пиццы
        buttons:
            "15 см" -> /Дополнительные опции
            "25 см" -> /Дополнительные опции
            "30 см" -> /Дополнительные опции
            "35 см" -> /Дополнительные опции

    state: Дополнительные опции
        a: Выберите тип борта
        buttons:
            "Сырный борт" -> /Введите адрес доставки
            "Обычный борт" -> /Введите адрес доставки

    state: Введите адрес доставки
        a: Введите адрес доставки

    state: NoMatch
        event!: noMatch
        a: Я не понял. Вы сказали: {{$request.query}}